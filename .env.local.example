# Self-hosted mode (set to true to bypass all plan/billing checks)
PREROLL_SELF_HOSTED=

# License key (optional — generated via Settings > License when self-hosted)
PREROLL_LICENSE_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (or any S3-compatible storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=preroll-assets
R2_PUBLIC_URL=

# Encryption key for storing API keys and integration tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=

# Stripe (not needed for self-hosted — billing is bypassed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_STUDIO_MONTHLY_PRICE_ID=
STRIPE_STUDIO_ANNUAL_PRICE_ID=

# Email notifications (optional — magic-link auth uses Supabase SMTP separately)
# HOSTED (SaaS): Uses Resend — set RESEND_API_KEY
# SELF-HOSTED:   Uses SMTP — set the SMTP_* variables below. RESEND_API_KEY is ignored.
RESEND_API_KEY=

# SMTP (self-hosted only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Integrations (optional — register your own OAuth apps)
FRAMEIO_CLIENT_ID=
FRAMEIO_CLIENT_SECRET=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=
# YouTube (can reuse GOOGLE_DRIVE_CLIENT_ID/SECRET if using the same Google Cloud OAuth client)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
NEXT_PUBLIC_R2_PUBLIC_URL=https://assets.preroll.io
